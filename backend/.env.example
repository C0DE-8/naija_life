NODE_ENV=development
PORT=3000
API_BASE_PATH=/api

# MySQL connection (create this database and import Ncity-master/SQL/Database SQL.sql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=naija_city
DB_USER=root
DB_PASSWORD=change_me
DB_CONNECTION_LIMIT=10

# Scheduled tasks are off until enabled. Energy refill runs once per hour when enabled.
ENABLE_CRON_JOBS=false
ENERGY_REFILL_CRON=0 * * * *
ENERGY_REFILL_AMOUNT=10
